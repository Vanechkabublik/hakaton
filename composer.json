{
    "name": "vancodex/news",
    "description": "News.vancodex.tech — медиа с платной подпиской на чистом PHP 8.3",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*",
        "phpmailer/phpmailer": "^6.9",
        "minishlink/web-push": "^9.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src bin public templates migrations -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
