# Скопируйте в .env (deploy.sh делает это сам и подставляет секреты).
# Значения без кавычек; избегайте символов $ и пробелов — docker compose трактует их особым образом.

# ---- Окружение ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=0
APP_TIMEZONE=Europe/Moscow

# ---- Домен и HTTPS (Caddy сам выпускает и продлевает сертификат Let's Encrypt) ---------------
# DNS A/AAAA-запись домена должна указывать на сервер, порты 80 и 443 — быть открытыми.
DOMAIN=news.vancodex.tech
APP_URL=https://news.vancodex.tech
# На этот адрес Let's Encrypt шлёт уведомления об истечении сертификата
ACME_EMAIL=
# Для проб без лимитов Let's Encrypt: https://acme-staging-v02.api.letsencrypt.org/directory (./deploy.sh --staging)
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Режим работы Caddy: Caddyfile — сам на портах 80/443 (по умолчанию); Caddyfile.proxy — за вашим веб-сервером
# (если 80/443 заняты другим сайтом). Переключается: ./deploy.sh --behind-proxy / ./deploy.sh --standalone
CADDYFILE=Caddyfile
# Где слушать на хосте: порт или адрес:порт (HTTPS_BIND=127.0.0.1: — порт назначит Docker)
HTTP_BIND=80
HTTPS_BIND=443

# ---- Ключ приложения (подпись cookie/токенов и шифрование секретов в настройках) ------------
# Сгенерировать: docker compose run --rm app console key:generate
# ВАЖНО: при потере ключа сохранённые в админке секреты (ЮKassa, SMTP, Яндекс) придётся ввести заново.
APP_KEY=

# ---- База данных PostgreSQL ------------------------------------------------------------------
DB_NAME=news
DB_USER=news
DB_PASSWORD=

# ---- Первый администратор (создаётся при первом запуске, если такого пользователя ещё нет) ---
ADMIN_EMAIL=
ADMIN_NAME=Администратор
# После первого входа смените пароль в кабинете и удалите эту строку
ADMIN_PASSWORD=

# ---- Сайт ------------------------------------------------------------------------------------
SITE_NAME=Новости Vancodex
CONTACT_EMAIL=
LOG_LEVEL=info
# Простой сессии до выхода, минут (вход с «Запомнить меня» живёт дольше)
SESSION_LIFETIME_MINUTES=480

# ---- Необязательные значения по умолчанию ----------------------------------------------------
# Всё это можно (и удобнее) вводить в админке: «Настройки». Значение, сохранённое в админке,
# имеет приоритет над переменной окружения.

# ЮKassa: Настройки → Интеграции (shopId и секретный ключ магазина).
# URL уведомлений в личном кабинете ЮKassa: https://<домен>/webhooks/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Яндекс ID: https://oauth.yandex.ru/ — Redirect URI: https://<домен>/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Почта (SMTP). Без неё письма складываются в storage/mail, а в production — не доставляются.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Web Push: docker compose run --rm app console vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Аналитика
YANDEX_METRIKA_ID=
GA4_ID=
