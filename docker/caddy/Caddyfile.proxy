# Режим «за вашим веб-сервером» (./deploy.sh --behind-proxy): порты 80/443 заняты другим сайтом, поэтому Caddy
# слушает только обычный HTTP на локальном порту, а HTTPS и сертификат даёт ваш веб-сервер (nginx, Caddy, Apache…).
# Заголовки X-Forwarded-For/Proto принимаются только от приватных адресов (loopback и сети Docker).
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	import site.caddy
}
